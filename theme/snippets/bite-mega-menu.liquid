{%- comment -%}
  snippets/bite-mega-menu.liquid  (v7 — taxonomy L3 + display_label)

  SOURCE OF TRUTH: shop.metafields.custom.taxonomy (json)

  Menu text uses display_label when set, else category/label.
  Links always use the stored handle — never derive handles from display_label.

  Visibility:
    verify: skip when indexable=false, then require live collection products > 0
    non-verify: render when visible=true

  Drawer markup mirrors Dawn link / childlink / grandchildlink for MenuDrawer.
{%- endcomment -%}

{%- liquid
  assign menu_title = title | default: 'Products'
  assign menu_layout = layout | default: 'desktop'
  assign menu_scheme = color_scheme | default: ''
  assign menu_handle = menu_title | handleize
  assign taxonomy = shop.metafields.custom.taxonomy.value

  if menu_layout == 'drawer'
    assign li_class = ''
    assign a_class = 'menu-drawer__menu-item link link--text list-menu__item focus-inset'
  else
    assign li_class = 'bite-mega__item'
    assign a_class = 'bite-mega__link link'
  endif
-%}

{%- capture menu_body -%}

  {%- for cat in taxonomy -%}
    {%- assign cat_handle = cat.handle | default: cat.category | handleize -%}
    {%- if cat.display_label != blank -%}
      {%- assign cat_label = cat.display_label -%}
    {%- else -%}
      {%- assign cat_label = cat.category -%}
    {%- endif -%}

    {%- capture column_links -%}
      {%- for sub in cat.subcategories -%}
        {%- if verify -%}
          {%- unless sub.indexable -%}{% continue %}{% endunless -%}
          {%- assign live = collections[sub.handle] -%}
          {%- if live.all_products_count == 0 -%}{% continue %}{% endif -%}
        {%- else -%}
          {%- unless sub.visible -%}{% continue %}{% endunless -%}
        {%- endif -%}

        {%- if sub.display_label != blank -%}
          {%- assign sub_label = sub.display_label -%}
        {%- else -%}
          {%- assign sub_label = sub.label -%}
        {%- endif -%}

        {%- comment -%} Build grandchild (sub-sub) list first {%- endcomment -%}
        {%- capture grandchild_links -%}
          {%- for child in sub.children -%}
            {%- if verify -%}
              {%- unless child.indexable -%}{% continue %}{% endunless -%}
              {%- assign child_live = collections[child.handle] -%}
              {%- if child_live.all_products_count == 0 -%}{% continue %}{% endif -%}
            {%- else -%}
              {%- unless child.visible -%}{% continue %}{% endunless -%}
            {%- endif -%}
            {%- if child.display_label != blank -%}
              {%- assign child_label = child.display_label -%}
            {%- else -%}
              {%- assign child_label = child.label -%}
            {%- endif -%}
            <li{% if li_class != blank %} class="{{ li_class }}"{% endif %}>
              <a href="{{ routes.collections_url }}/{{ child.handle }}" class="{{ a_class }}{% if menu_layout == 'drawer' %} list-menu__item--link{% endif %}">
                {{- child_label | escape -}}
              </a>
            </li>
          {%- endfor -%}
        {%- endcapture -%}
        {%- assign grandchild_check = grandchild_links | strip -%}

        {%- if menu_layout == 'drawer' and grandchild_check != blank -%}
          <li>
            <details id="Details-menu-drawer-bite-{{ cat_handle }}-{{ sub.handle }}">
              <summary
                id="HeaderDrawer-bite-{{ menu_handle }}-{{ cat_handle }}-{{ sub.handle }}"
                class="menu-drawer__menu-item link link--text list-menu__item focus-inset"
              >
                {{ sub_label | escape }}
                <span class="svg-wrapper">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
                <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
              </summary>
              <div
                id="grandchildlink-bite-{{ cat_handle }}-{{ sub.handle }}"
                class="menu-drawer__submenu has-submenu gradient motion-reduce"
              >
                <button class="menu-drawer__close-button link link--text focus-inset" aria-expanded="true">
                  <span class="svg-wrapper">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
                  {{ sub_label | escape }}
                </button>
                <ul class="menu-drawer__menu list-menu" role="list" tabindex="-1">
                  <li>
                    <a href="{{ routes.collections_url }}/{{ sub.handle }}" class="{{ a_class }} list-menu__item--link">
                      {{- 'All ' | append: sub_label | escape -}}
                    </a>
                  </li>
                  {{ grandchild_links }}
                </ul>
              </div>
            </details>
          </li>
        {%- elsif menu_layout == 'desktop' and grandchild_check != blank -%}
          <li class="bite-mega__item bite-mega__item--nested">
            <a href="{{ routes.collections_url }}/{{ sub.handle }}" class="{{ a_class }} bite-mega__link--parent">
              {{- sub_label | escape -}}
            </a>
            <ul class="bite-mega__sublist" role="list">
              {{ grandchild_links }}
            </ul>
          </li>
        {%- else -%}
          <li{% if li_class != blank %} class="{{ li_class }}"{% endif %}>
            <a href="{{ routes.collections_url }}/{{ sub.handle }}" class="{{ a_class }}">
              {{- sub_label | escape -}}
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}

    {%- assign column_check = column_links | strip -%}
    {%- if column_check == blank -%}{% continue %}{% endif -%}

    {%- assign cat_url = blank -%}
    {%- if cat.visible and cat.handle != blank -%}
      {%- assign cat_url = routes.collections_url | append: '/' | append: cat.handle -%}
    {%- endif -%}

    {%- if menu_layout == 'drawer' -%}

      <li>
        <details id="Details-menu-drawer-bite-{{ cat_handle }}">
          <summary
            id="HeaderDrawer-bite-{{ menu_handle }}-{{ cat_handle }}"
            class="menu-drawer__menu-item link link--text list-menu__item focus-inset"
          >
            {{ cat_label | escape }}
            <span class="svg-wrapper">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
            <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
          </summary>
          <div
            id="childlink-bite-{{ cat_handle }}"
            class="menu-drawer__submenu has-submenu gradient motion-reduce"
          >
            <button class="menu-drawer__close-button link link--text focus-inset" aria-expanded="true">
              <span class="svg-wrapper">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
              {{ cat_label | escape }}
            </button>
            <ul class="menu-drawer__menu list-menu" role="list" tabindex="-1">
              {%- if cat_url != blank -%}
                <li>
                  <a href="{{ cat_url }}" class="{{ a_class }}">
                    {{- 'All ' | append: cat_label | escape -}}
                  </a>
                </li>
              {%- endif -%}
              {{ column_links }}
            </ul>
          </div>
        </details>
      </li>

    {%- else -%}

      <div class="bite-mega__column">
        {%- if cat_url != blank -%}
          <p class="bite-mega__column-title">
            <a href="{{ cat_url }}" class="bite-mega__column-link link">{{ cat_label | escape }}</a>
          </p>
        {%- else -%}
          <p class="bite-mega__column-title">{{ cat_label | escape }}</p>
        {%- endif -%}
        <ul class="bite-mega__list" role="list">{{ column_links }}</ul>
      </div>

    {%- endif -%}
  {%- endfor -%}

{%- endcapture -%}

{%- if debug -%}
  {%- assign vis_subs = 0 -%}
  {%- assign all_subs = 0 -%}
  {%- assign vis_children = 0 -%}
  {%- assign all_children = 0 -%}
  {%- for cat in taxonomy -%}
    {%- for sub in cat.subcategories -%}
      {%- assign all_subs = all_subs | plus: 1 -%}
      {%- if sub.visible -%}{%- assign vis_subs = vis_subs | plus: 1 -%}{%- endif -%}
      {%- for child in sub.children -%}
        {%- assign all_children = all_children | plus: 1 -%}
        {%- if child.visible -%}{%- assign vis_children = vis_children | plus: 1 -%}{%- endif -%}
      {%- endfor -%}
    {%- endfor -%}
  {%- endfor -%}
  <pre style="font: 12px/1.5 monospace; padding: 1rem; background: #ffe;">
layout          : {{ menu_layout }}
metafield found : {% if taxonomy %}yes{% else %}NO — check custom.taxonomy exists and has storefront access{% endif %}
categories      : {{ taxonomy.size }}
subcategories   : {{ vis_subs }} visible of {{ all_subs }}
sub-subs        : {{ vis_children }} visible of {{ all_children }}
verify mode     : {% if verify %}ON (live counts, slow){% else %}off (trusting visible flag){% endif %}
  </pre>
{%- endif -%}

{%- assign menu_check = menu_body | strip -%}
{%- if menu_check != blank -%}

  {%- if menu_layout == 'drawer' -%}

    <li>
      <details id="Details-menu-drawer-bite-{{ menu_handle }}">
        <summary
          id="HeaderDrawer-bite-{{ menu_handle }}"
          class="menu-drawer__menu-item list-menu__item link link--text focus-inset"
        >
          {{ menu_title | escape }}
          <span class="svg-wrapper">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
          <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
        </summary>
        <div
          id="link-bite-{{ menu_handle }}"
          class="menu-drawer__submenu has-submenu gradient motion-reduce"
          tabindex="-1"
        >
          <div class="menu-drawer__inner-submenu">
            <button class="menu-drawer__close-button link link--text focus-inset" aria-expanded="true">
              <span class="svg-wrapper">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
              {{ menu_title | escape }}
            </button>
            <ul class="menu-drawer__menu list-menu" role="list" tabindex="-1">
              {{ menu_body }}
            </ul>
          </div>
        </div>
      </details>
    </li>

  {%- else -%}

    <style>
      .bite-mega__inner {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
        gap: 3rem;
        align-items: start;
      }
      .bite-mega__column-title {
        margin: 0 0 1.2rem;
        padding-bottom: 0.8rem;
        border-bottom: 0.1rem solid rgba(var(--color-foreground), 0.12);
        font-size: 1.5rem;
        font-weight: 600;
        line-height: 1.3;
        color: rgb(var(--color-foreground));
      }
      .bite-mega__column-link { color: inherit; text-decoration: none; }
      .bite-mega__column-link:hover,
      .bite-mega__column-link:focus-visible {
        text-decoration: underline;
        text-underline-offset: 0.3rem;
      }
      .bite-mega__list { margin: 0; padding: 0; list-style: none; }
      .bite-mega__sublist {
        margin: 0.2rem 0 0.6rem 1.2rem;
        padding: 0;
        list-style: none;
      }
      .bite-mega__link {
        display: block;
        padding: 0.5rem 0;
        font-size: 1.4rem;
        line-height: 1.4;
        text-decoration: none;
        color: rgba(var(--color-foreground), 0.75);
      }
      .bite-mega__link--parent { font-weight: 600; color: rgb(var(--color-foreground)); }
      .bite-mega__sublist .bite-mega__link {
        font-size: 1.3rem;
        padding: 0.35rem 0;
        color: rgba(var(--color-foreground), 0.65);
      }
      .bite-mega__link:hover,
      .bite-mega__link:focus-visible {
        color: rgb(var(--color-foreground));
        text-decoration: underline;
        text-underline-offset: 0.3rem;
      }
    </style>

    <header-menu>
      <details id="Details-BiteMegaMenu" class="mega-menu">
        <summary
          id="HeaderMenu-bite-products"
          class="header__menu-item list-menu__item link focus-inset"
        >
          <span>{{ menu_title | escape }}</span>
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </summary>
        <div
          id="MegaMenu-Content-Bite"
          class="mega-menu__content color-{{ menu_scheme }} gradient motion-reduce global-settings-popup"
          tabindex="-1"
        >
          <div class="bite-mega__inner page-width">
            {{ menu_body }}
          </div>
        </div>
      </details>
    </header-menu>

  {%- endif -%}

{%- endif -%}
