{%- comment -%}
  snippets/bite-mega-menu.liquid  (v6 — taxonomy metafield, desktop + drawer)

  Replaces v5's self-discovery. The menu is now read from a single shop
  metafield rather than derived by enumerating every collection and parsing
  its title.

  ---------------------------------------------------------------------------
  SOURCE OF TRUTH

    shop.metafields.custom.taxonomy   (type: json)

    [
      {
        "category": "Chocolate",
        "handle": "personalised-chocolate",
        "position": 1,
        "visible": true,
        "subcategories": [
          { "label": "Bars",
            "handle": "personalised-chocolate-bars",
            "position": 1,
            "indexable": true,
            "metafield_key": "subcategory",
            "visible": true }
        ]
      }
    ]

  Written by the Product Manager app. Nothing in this file needs editing to
  add, remove, rename or reorder anything in the menu.

  ---------------------------------------------------------------------------
  WHAT CHANGED FROM v5

    gone   the `collections` enumeration, and with it the 50-iteration cap
           that was silently truncating the menu
    gone   `all_products_count` called once per collection on every page load
    gone   title parsing on " - ", so renaming a collection can no longer
           break a menu column
    gone   the column_order and item_pins config blocks — ordering is the
           `position` field, edited in the app

  Cost is now one metafield read plus a loop over ~11 categories.

  ---------------------------------------------------------------------------
  VISIBILITY

  Deliberate mega-menu exclusion is enforced by `indexable` in Liquid — not by
  assuming unpublished collections are hidden. Phase 7 keeps Online Store
  publish + taxonomy `visible` aligned with Online-Store-published product
  counts, but if someone republishes a non-indexable collection in Admin,
  verify mode must still skip it.

  Non-verify path: render when `visible` is true (info / fast path).
  Verify path: skip when `indexable` is false, then require a live collection
  with products (`all_products_count` > 0). Unpublished collections report 0.

  Pass verify: true to cross-check against live product counts instead of
  trusting `visible` alone. Live theme uses verify; that costs one collection
  lookup per entry.

  ---------------------------------------------------------------------------
  PARAMETERS

    title          top-level label. Default: Products.
    layout         'desktop' or 'drawer'. Default: desktop.
    color_scheme   passed explicitly; `section` does not resolve two render
                   levels deep. Desktop only.
    verify         cross-check with indexable gate + live counts (storefront).
    debug          print a diagnostic block.

  ---------------------------------------------------------------------------
  The drawer branch still mirrors Dawn's link / childlink / grandchildlink
  markup class-for-class, because MenuDrawer binds to every <summary>, reads
  summary.nextElementSibling as the sliding panel, details.closest('.has-submenu')
  as the container to mark open, and details.querySelector('button') as the
  focus-trap anchor. It emits <li> elements and must be rendered inside a <ul>.
{%- endcomment -%}

{%- liquid
  assign menu_title = title | default: 'Products'
  assign menu_layout = layout | default: 'desktop'
  assign menu_scheme = color_scheme | default: ''
  assign menu_handle = menu_title | handleize
  assign taxonomy = shop.metafields.custom.taxonomy.value

  if menu_layout == 'drawer'
    assign li_class = ''
    assign a_class = 'menu-drawer__menu-item link link--text list-menu__item focus-inset'
  else
    assign li_class = 'bite-mega__item'
    assign a_class = 'bite-mega__link link'
  endif
-%}

{%- capture menu_body -%}

  {%- for cat in taxonomy -%}
    {%- assign cat_handle = cat.handle | default: cat.category | handleize -%}

    {%- capture column_links -%}
      {%- for sub in cat.subcategories -%}
        {%- if verify -%}
          {%- unless sub.indexable -%}{% continue %}{% endunless -%}
          {%- assign live = collections[sub.handle] -%}
          {%- if live.all_products_count == 0 -%}{% continue %}{% endif -%}
        {%- else -%}
          {%- unless sub.visible -%}{% continue %}{% endunless -%}
        {%- endif -%}
        <li{% if li_class != blank %} class="{{ li_class }}"{% endif %}>
          <a href="{{ routes.collections_url }}/{{ sub.handle }}" class="{{ a_class }}">
            {{- sub.label | escape -}}
          </a>
        </li>
      {%- endfor -%}
    {%- endcapture -%}

    {%- assign column_check = column_links | strip -%}
    {%- if column_check == blank -%}{% continue %}{% endif -%}

    {%- assign cat_url = blank -%}
    {%- if cat.visible and cat.handle != blank -%}
      {%- assign cat_url = routes.collections_url | append: '/' | append: cat.handle -%}
    {%- endif -%}

    {%- if menu_layout == 'drawer' -%}

      <li>
        <details id="Details-menu-drawer-bite-{{ cat_handle }}">
          <summary
            id="HeaderDrawer-bite-{{ menu_handle }}-{{ cat_handle }}"
            class="menu-drawer__menu-item link link--text list-menu__item focus-inset"
          >
            {{ cat.category | escape }}
            <span class="svg-wrapper">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
            <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
          </summary>
          <div
            id="childlink-bite-{{ cat_handle }}"
            class="menu-drawer__submenu has-submenu gradient motion-reduce"
          >
            <button class="menu-drawer__close-button link link--text focus-inset" aria-expanded="true">
              <span class="svg-wrapper">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
              {{ cat.category | escape }}
            </button>
            <ul class="menu-drawer__menu list-menu" role="list" tabindex="-1">
              {%- if cat_url != blank -%}
                <li>
                  <a href="{{ cat_url }}" class="{{ a_class }}">
                    {{- 'All ' | append: cat.category | escape -}}
                  </a>
                </li>
              {%- endif -%}
              {{ column_links }}
            </ul>
          </div>
        </details>
      </li>

    {%- else -%}

      <div class="bite-mega__column">
        {%- if cat_url != blank -%}
          <p class="bite-mega__column-title">
            <a href="{{ cat_url }}" class="bite-mega__column-link link">{{ cat.category | escape }}</a>
          </p>
        {%- else -%}
          <p class="bite-mega__column-title">{{ cat.category | escape }}</p>
        {%- endif -%}
        <ul class="bite-mega__list" role="list">{{ column_links }}</ul>
      </div>

    {%- endif -%}
  {%- endfor -%}

{%- endcapture -%}

{%- if debug -%}
  {%- assign vis_subs = 0 -%}
  {%- assign all_subs = 0 -%}
  {%- for cat in taxonomy -%}
    {%- for sub in cat.subcategories -%}
      {%- assign all_subs = all_subs | plus: 1 -%}
      {%- if sub.visible -%}{%- assign vis_subs = vis_subs | plus: 1 -%}{%- endif -%}
    {%- endfor -%}
  {%- endfor -%}
  <pre style="font: 12px/1.5 monospace; padding: 1rem; background: #ffe;">
layout          : {{ menu_layout }}
metafield found : {% if taxonomy %}yes{% else %}NO — check custom.taxonomy exists and has storefront access{% endif %}
categories      : {{ taxonomy.size }}
subcategories   : {{ vis_subs }} visible of {{ all_subs }}
verify mode     : {% if verify %}ON (live counts, slow){% else %}off (trusting visible flag){% endif %}
  </pre>
{%- endif -%}

{%- assign menu_check = menu_body | strip -%}
{%- if menu_check != blank -%}

  {%- if menu_layout == 'drawer' -%}

    <li>
      <details id="Details-menu-drawer-bite-{{ menu_handle }}">
        <summary
          id="HeaderDrawer-bite-{{ menu_handle }}"
          class="menu-drawer__menu-item list-menu__item link link--text focus-inset"
        >
          {{ menu_title | escape }}
          <span class="svg-wrapper">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
          <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
        </summary>
        <div
          id="link-bite-{{ menu_handle }}"
          class="menu-drawer__submenu has-submenu gradient motion-reduce"
          tabindex="-1"
        >
          <div class="menu-drawer__inner-submenu">
            <button class="menu-drawer__close-button link link--text focus-inset" aria-expanded="true">
              <span class="svg-wrapper">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
              {{ menu_title | escape }}
            </button>
            <ul class="menu-drawer__menu list-menu" role="list" tabindex="-1">
              {{ menu_body }}
            </ul>
          </div>
        </div>
      </details>
    </li>

  {%- else -%}

    <style>
      /* Panel positioning, z-index, colour scheme and the open animation all
         come from the theme's component-mega-menu.css. */
      .bite-mega__inner {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
        gap: 3rem;
        align-items: start;
      }
      .bite-mega__column-title {
        margin: 0 0 1.2rem;
        padding-bottom: 0.8rem;
        border-bottom: 0.1rem solid rgba(var(--color-foreground), 0.12);
        font-size: 1.5rem;
        font-weight: 600;
        line-height: 1.3;
        color: rgb(var(--color-foreground));
      }
      .bite-mega__column-link { color: inherit; text-decoration: none; }
      .bite-mega__column-link:hover,
      .bite-mega__column-link:focus-visible {
        text-decoration: underline;
        text-underline-offset: 0.3rem;
      }
      .bite-mega__list { margin: 0; padding: 0; list-style: none; }
      .bite-mega__link {
        display: block;
        padding: 0.5rem 0;
        font-size: 1.4rem;
        line-height: 1.4;
        text-decoration: none;
        color: rgba(var(--color-foreground), 0.75);
      }
      .bite-mega__link:hover,
      .bite-mega__link:focus-visible {
        color: rgb(var(--color-foreground));
        text-decoration: underline;
        text-underline-offset: 0.3rem;
      }
    </style>

    <header-menu>
      <details id="Details-BiteMegaMenu" class="mega-menu">
        <summary
          id="HeaderMenu-bite-products"
          class="header__menu-item list-menu__item link focus-inset"
        >
          <span>{{ menu_title | escape }}</span>
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </summary>
        <div
          id="MegaMenu-Content-Bite"
          class="mega-menu__content color-{{ menu_scheme }} gradient motion-reduce global-settings-popup"
          tabindex="-1"
        >
          <div class="bite-mega__inner page-width">
            {{ menu_body }}
          </div>
        </div>
      </details>
    </header-menu>

  {%- endif -%}

{%- endif -%}
