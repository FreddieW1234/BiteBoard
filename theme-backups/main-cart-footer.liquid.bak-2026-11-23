                    <div style="margin-bottom: 20px;">
                        <label for="popup-delivery-name" style="display: block; margin-bottom: 8px; font-weight: 600; color: #333;">Name: *</label>
                        <input
                        type="text"
                        id="popup-delivery-name"
                        placeholder="Enter delivery contact name"
                        style="width: 100%; padding: 12px; border: 1px solid #ccc; border-radius: 8px; font-size: 14px; box-sizing: border-box; font-family: inherit;"
