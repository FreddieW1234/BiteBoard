            {%- comment -%} Fees summary — grouped by product, fees high-to-low per product {%- endcomment -%}
            {%- assign _fee_handles = 'origination-fee,foiling-fee,mailer-fee,mailer-packing-fee,duplex-fee' | split: ',' -%}
            {%- assign has_fee_lines = false -%}
            {%- for item in cart.items -%}
              {%- if _fee_handles contains item.product.handle -%}{%- assign has_fee_lines = true -%}{%- break -%}{%- endif -%}
            {%- endfor -%}
            {%- if has_fee_lines -%}
              {%- assign fee_products = '' -%}
              {%- for item in cart.items -%}
                {%- if _fee_handles contains item.product.handle -%}
                  {%- assign _p = item.properties._for_product | default: item.product.title -%}
                  {%- unless fee_products contains _p -%}
                    {%- if fee_products == '' -%}{%- assign fee_products = _p -%}{%- else -%}{%- assign fee_products = fee_products | append: '~~' | append: _p -%}{%- endif -%}
                  {%- endunless -%}
                {%- endif -%}
              {%- endfor -%}
              {%- assign fee_product_list = fee_products | split: '~~' -%}
              <div class="cart-footer-fees">
                <div class="origination-fee-summary">
                  <div class="origination-fee-summary__title">Fees</div>
                  {%- for prod in fee_product_list -%}
                   <div class="origination-fee-summary__product" style="margin-top:10px; margin-bottom:2px; font-size:13px; font-weight:600; font-style:italic; color:#777;">{{ prod | escape }}</div>
                    {%- assign pcount = 0 -%}
                    {%- for item in cart.items -%}
                      {%- if _fee_handles contains item.product.handle -%}
                        {%- assign _p = item.properties._for_product | default: item.product.title -%}
                        {%- if _p == prod -%}{%- assign pcount = pcount | plus: 1 -%}{%- endif -%}
                      {%- endif -%}
                    {%- endfor -%}
                    {%- assign shown_keys = '' -%}
                    {%- for i in (1..pcount) -%}
                      {%- assign best = null -%}
                      {%- assign best_price = -1 -%}
                      {%- for item in cart.items -%}
                        {%- if _fee_handles contains item.product.handle -%}
                          {%- assign _p = item.properties._for_product | default: item.product.title -%}
                          {%- if _p == prod -%}
                            {%- unless shown_keys contains item.key -%}
                              {%- if item.final_line_price > best_price -%}
                                {%- assign best = item -%}
                                {%- assign best_price = item.final_line_price -%}
                              {%- endif -%}
                            {%- endunless -%}
                          {%- endif -%}
                        {%- endif -%}
                      {%- endfor -%}
                      {%- if best -%}
                        {%- assign shown_keys = shown_keys | append: ',' | append: best.key -%}
                        {%- assign h = best.product.handle -%}
                        <div class="origination-fee-summary__row" style="padding-left:8px;">
                          <span class="origination-fee-summary__label">
                            {%- if h == 'origination-fee' -%}Origination Fee <span class="origination-fee-help" tabindex="0" role="button" aria-label="Origination fee information">?<span class="origination-fee-help__tooltip">The origination fee is for setting up our die cutting &amp; finishing machines for products that require such processes.</span></span>
                            {%- elsif h == 'foiling-fee' -%}Foiling
                            {%- elsif h == 'mailer-fee' -%}Mailer
                            {%- elsif h == 'mailer-packing-fee' -%}Mailer Packing
                            {%- elsif h == 'duplex-fee' -%}Double-Sided Print
                            {%- endif -%}
                          </span>
                          <span class="origination-fee-summary__amount">{{ best.final_line_price | money }}</span>
                        </div>
                      {%- endif -%}
                    {%- endfor -%}
                  {%- endfor -%}
                </div>
              </div>
            {%- endif -%}

            <div class="cart__blocks">
            {% for block in section.blocks %}
                {%- case block.type -%}
                {%- when '@app' -%}
                    {% render block %}
                {%- when 'subtotal' -%}
                    <div class="js-contents" {{ block.shopify_attributes }}>
                    <div>
                        {%- if cart.cart_level_discount_applications.size > 0 -%}
                        <ul class="discounts list-unstyled" role="list" aria-label="{{ 'customer.order.discount' | t }}">
                            {%- for discount in cart.cart_level_discount_applications -%}
                            <li class="discounts__discount discounts__discount--position">
                                {{- 'icon-discount.svg' | inline_asset_content -}}
                                {%- if discount.title contains 'Origination' -%}Origination{%- else -%}{{ discount.title | escape }}{%- endif -%}
                                (-{{ discount.total_allocated_amount | money }})
                            </li>
                            {%- endfor -%}
                        </ul>
                        {%- endif -%}
