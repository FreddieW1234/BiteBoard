    {%- if cart != empty -%}
    {{ 'component-cart.css' | asset_url | stylesheet_tag }}
    {{ 'component-totals.css' | asset_url | stylesheet_tag }}
    {{ 'component-price.css' | asset_url | stylesheet_tag }}
    {{ 'component-discounts.css' | asset_url | stylesheet_tag }}

    {%- style -%}
        .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
        padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
        }

        @media screen and (min-width: 750px) {
        .section-{{ section.id }}-padding {
            padding-top: {{ section.settings.padding_top }}px;
            padding-bottom: {{ section.settings.padding_bottom }}px;
        }
        }
        
        /* Override cart footer CSS rules */
        .cart__footer > * {
        width: auto !important;
        }

        .cart-footer-layout {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-start;
        gap: 20px;
        width: 100% !important;
        }

        .cart-footer-fees {
        flex: 0 0 480px;
        max-width: 480px;
        align-self: flex-start;
        }
        
        /* Keep the margin for right alignment but reduce it */
        .cart-footer-layout > * + * {
        margin-left: 0 !important;
        }
        
        /* Make checkout button right-aligned like the text above */
        .cart__ctas {
        text-align: right !important;
        }
        
        /* Constrain totals/checkout section */
        .cart-footer-layout .cart__blocks {
        flex: 0 0 300px;
        max-width: 300px !important;
        margin-left: auto !important;
        }
        
        /* Ensure the checkout button itself is right-aligned */
        .cart__checkout-button {
        margin-left: auto !important;
        margin-right: 0 !important;
        width: 100% !important;
        max-width: 320px !important;
        }
        
        /* More specific selector to override theme CSS */
        .cart__ctas .cart__checkout-button {
        width: 100% !important;
        max-width: 320px !important;
        min-width: 0 !important;
        }
        
        /* Ensure popup is absolutely on top of everything including site footer */
        #nameAddressPopup {
        z-index: 2147483647 !important;
        position: fixed !important;
        top: 0 !important;
        left: 0 !important;
        width: 100% !important;
        height: 100% !important;
        }
        
        /* Override any theme CSS that might interfere */
        body #nameAddressPopup,
        html #nameAddressPopup,
        * #nameAddressPopup {
        z-index: 2147483647 !important;
        }
        
        /* Additional popup positioning to ensure it's above everything */
        #nameAddressPopup {
        position: fixed !important;
        top: 0 !important;
        left: 0 !important;
        right: 0 !important;
        bottom: 0 !important;
        z-index: 2147483647 !important;
        }
        
        /* Ensure popup is moved to body for highest stacking context */
        body > #nameAddressPopup {
        z-index: 2147483647 !important;
        }

        .cart-footer-fields {
        display: flex;
        gap: 20px;
        align-items: flex-start;
        flex-wrap: wrap;
        width: auto !important;
        flex: 1 1 640px;
        min-width: 0;
        }

        .cart-footer-fields__col {
        flex: 0 0 280px;
        max-width: 280px;
        }

        .cart-footer-fields__col input,
        .cart-footer-fields__col textarea,
        .cart-footer-fields__col button {
        width: 100%;
        box-sizing: border-box;
        }

        .cart-footer-field-label {
        display: block;
        margin-bottom: 5px;
        font-weight: 600;
        color: #333;
        line-height: 1.2;
        min-height: 17px;
        }

        .cart-footer-fields__notes {
        min-height: 132px;
        resize: vertical;
        }

        .origination-fee-summary {
        margin: 0 0 1rem 0;
        width: 100%;
        padding: 0.85rem 1rem;
        border: 1px solid #e3e3e3;
        border-radius: 8px;
        box-sizing: border-box;
        }

        .origination-fee-summary__title {
        font-size: 0.78em;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: #666;
        margin-bottom: 0.5rem;
        }

        .origination-fee-summary__row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1rem;
        padding: 0.2rem 0;
        font-size: 0.85em;
        font-style: italic;
        font-weight: 500;
        color: #888;
        line-height: 1.35;
        }

        .origination-fee-summary__amount {
        font-style: normal;
        white-space: nowrap;
        }

        .origination-fee-summary__label {
        flex: 1;
        min-width: 0;
        }

        .origination-fee-help {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 14px;
        height: 14px;
        margin-left: 0.15rem;
        border-radius: 50%;
        border: 1px solid #888;
        font-size: 10px;
        font-weight: 700;
        font-style: normal;
        line-height: 1;
        color: #888;
        cursor: help;
        position: relative;
        vertical-align: middle;
        top: -1px;
        }

        .origination-fee-help__tooltip {
        position: absolute;
        left: 50%;
        bottom: calc(100% + 8px);
        transform: translateX(-50%);
        width: max-content;
        max-width: 240px;
        padding: 8px 10px;
        border-radius: 6px;
        background: #333;
        color: #fff;
        font-size: 12px;
        font-weight: 400;
        font-style: normal;
        line-height: 1.4;
        text-align: left;
        white-space: normal;
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition: opacity 0.15s ease, visibility 0.15s ease;
        z-index: 10;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
        }

        .origination-fee-help:hover .origination-fee-help__tooltip,
        .origination-fee-help:focus .origination-fee-help__tooltip,
        .origination-fee-help:focus-visible .origination-fee-help__tooltip {
        opacity: 1;
        visibility: visible;
        }

        .required-empty {
        background-color: #e8f4fc !important;
        }

        .required-filled {
        background-color: #fff !important;
        }

        .required-btn-empty {
        background-color: #b8d4f0 !important;
        color: #333 !important;
        }

        .required-btn-filled {
        background-color: #9e9e9e !important;
        color: #fff !important;
        }

        .product-address-toggle {
        display: flex;
        border: 1px solid #ccc;
        border-radius: 8px;
        overflow: hidden;
        margin-top: 8px;
        }

        .product-address-toggle.required-empty {
        border-color: #b8d4f0;
        box-shadow: 0 0 0 2px #e8f4fc;
        }

        .toggle-btn {
        flex: 1;
        padding: 12px 8px;
        border: none;
        background: #f5f5f5;
        cursor: pointer;
        font-weight: 600;
        font-size: 13px;
        font-family: inherit;
        transition: background-color 0.2s ease, color 0.2s ease;
        }

        .toggle-btn.selected {
        background: #5977ED;
        color: #fff;
        }

        .cart-footer-action-btn {
        font-size: 1em;
        font-weight: 600;
        text-decoration: none;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        padding: 16px 12px;
        transition: background-color 0.3s ease;
        border: none;
        height: auto;
        min-height: 50px;
        text-align: center;
        line-height: 1.2;
        width: 100%;
        box-sizing: border-box;
        font-family: inherit;
        }

        #delivery-btn {
        min-height: 40px;
        height: 40px;
        padding: 8px 12px;
        border-radius: 15px;
        }

        #deliveryPopup {
        z-index: 2147483647 !important;
        position: fixed !important;
        top: 0 !important;
        left: 0 !important;
        width: 100% !important;
        height: 100% !important;
        }

        @keyframes validation-pulse {
        0%, 100% {
            box-shadow: 0 0 0 0 rgba(89, 119, 237, 0);
            transform: scale(1);
        }
        50% {
            box-shadow: 0 0 0 5px rgba(89, 119, 237, 0.35);
            transform: scale(1.02);
        }
        }

        .validation-pulse-once {
        animation: validation-pulse 0.65s ease-in-out 1;
        }
        /* ---------- Delivery method toggle (Shipping / Pickup) ---------- */
        .delivery-method-toggle {
        display: flex;
        border: 1px solid #ccc;
        border-radius: 8px;
        overflow: hidden;
        margin-top: 0;
        }
        .method-btn {
        flex: 1;
        padding: 12px 8px;
        border: none;
        background: #f5f5f5;
        cursor: pointer;
        font-weight: 600;
        font-size: 13px;
        font-family: inherit;
        color: #333;
        transition: background-color 0.2s ease, color 0.2s ease;
        }
        .method-btn.selected {
        background: #5977ED;
        color: #fff;
        }
        .method-btn:focus-visible { outline: 2px solid #14202e; outline-offset: -2px; }

        /* ---------- Collection notice (button shown when Pickup is chosen + popup) ---------- */
        #pickupDetails .bpcol-open { max-width: none; margin-left: 0; }
        .bpcol-open {
        width: 100%; max-width: 320px; margin-left: auto; display: flex; align-items: center; gap: 10px;
        padding: 10px 14px; border: 1.5px solid #ef6ba8; border-radius: 10px; background: #fff;
        color: #14202e; font: inherit; font-size: 14px; line-height: 1.3; cursor: pointer; text-align: left;
        box-sizing: border-box;
        }
        .bpcol-open svg { color: #ef6ba8; flex: none; }
        .bpcol-open:hover { background: #fdf0f6; }
        .bpcol-open:focus-visible { outline: 2px solid #14202e; outline-offset: 2px; }
        .bpcol-label { display: flex; flex-direction: column; }
        .bpcol-label strong { font-size: 15px; }
        .bpcol-label span { text-decoration: underline; text-underline-offset: 2px; color: #4a5666; }

        .bpcol-dialog { border: 0; padding: 0; border-radius: 16px; width: min(600px, calc(100% - 32px)); max-height: calc(100% - 48px); overflow: auto; overscroll-behavior: contain; color: #14202e; box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3); }
        .bpcol-dialog::backdrop { background: rgba(20, 32, 46, 0.55); }
        .bpcol-inner { position: relative; padding: 28px 28px 22px; font-size: 15px; line-height: 1.5; text-align: left; }
        .bpcol-inner h2 { margin: 0 32px 10px 0; font-size: 22px; }
        .bpcol-inner h3 { margin: 18px 0 6px; font-size: 16px; }
        .bpcol-inner p { margin: 0 0 10px; }
        .bpcol-inner ul { margin: 0; padding-left: 20px; }
        .bpcol-inner li { margin: 0 0 6px; }
        .bpcol-inner address { font-style: normal; margin-bottom: 12px; }
        .bpcol-inner a { color: inherit; }
        .bpcol-next { margin-top: 14px !important; padding: 10px 12px; background: #fdf0f6; border-left: 3px solid #ef6ba8; border-radius: 6px; }
        .bpcol-x { position: absolute; top: 14px; right: 16px; border: 0; background: none; font-size: 28px; line-height: 1; cursor: pointer; color: #14202e; }
        .bpcol-actions { display: flex; gap: 10px; justify-content: flex-end; flex-wrap: wrap; margin-top: 18px; }
        .bpcol-actions button { font: inherit; font-size: 15px; padding: 11px 18px; border-radius: 10px; cursor: pointer; }
        .bpcol-close-btn { border: 1.5px solid #c9ced6; background: #fff; color: #14202e; }
        .bpcol-go { border: 0; background: #ef6ba8; color: #fff; font-weight: 600; }

        /* ---------- Desktop layout: fields on the left; fees, totals, collection
           button and Check out stacked as one column on the right ---------- */
        @media screen and (min-width: 990px) {
        .cart-footer-layout {
            display: grid;
            grid-template-columns: minmax(0, 1fr) 320px;
            grid-template-rows: auto 1fr;
            column-gap: 40px;
            row-gap: 16px;
            align-items: start;
        }
        .cart-footer-layout > .cart-footer-fields { grid-column: 1; grid-row: 1 / span 2; }
        .cart-footer-layout > .cart-footer-fees { grid-column: 2; grid-row: 1; flex: none; max-width: none; width: 100% !important; }
        .cart-footer-layout > .cart-footer-fees .origination-fee-summary { margin: 0; }
        .cart-footer-layout > .cart__blocks { grid-column: 2; grid-row: 2; flex: none; max-width: none !important; width: 100% !important; margin-left: 0 !important; }
        .cart-footer-layout .cart__ctas .cart__checkout-button,
        .cart-footer-layout .bpcol-open { max-width: none !important; }
        }

        @media screen and (max-width: 749px) {
        .bpcol-open { max-width: none; }
        .bpcol-inner { padding: 22px 18px 18px; font-size: 14.5px; }
        .bpcol-actions button { flex: 1 1 auto; }
        }
    {%- endstyle -%}

    <div class="gradient color-{{ section.settings.color_scheme }}{% if cart == empty %} is-empty{% endif %}" id="main-cart-footer" data-id="{{ section.id }}">
        <div class="page-width">
        <div class="cart__footer isolate section-{{ section.id }}-padding">
            <div class="cart-footer-layout">
            {%- if settings.show_cart_note -%}
            <div class="cart-footer-fields">
                <div class="cart-footer-fields__col">
                    <label for="po-number" class="cart-footer-field-label">PO Number *</label>
                    <input
                    type="text"
                    name="po_number"
                    form="cart"
                    id="po-number"
                    placeholder="Enter PO Number"
                    class="required-empty"
                    style="border-radius: 15px !important; height: 40px; padding: 8px 12px; border: 1px solid #ccc;"
                    >

                    <label class="cart-footer-field-label" style="margin-top: 15px;">Delivery method *</label>
                    <div class="delivery-method-toggle" id="deliveryMethodToggle" role="group" aria-label="Delivery method">
                        <button type="button" class="method-btn selected" data-method="shipping" aria-pressed="true" onclick="selectDeliveryMethod('shipping')">Shipping</button>
                        <button type="button" class="method-btn" data-method="pickup" aria-pressed="false" onclick="selectDeliveryMethod('pickup')">Pickup</button>
                    </div>

                    <div id="pickupDetails" style="display: none; margin-top: 15px;">
                    <button type="button" class="bpcol-open" onclick="openCollectionPopup()" aria-haspopup="dialog">
                        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path fill="currentColor" d="M3 7l9-4 9 4v10l-9 4-9-4V7zm9-1.8L6.2 7.7 12 10.3l5.8-2.6L12 5.2zM5 9.2v6.5l6 2.7v-6.5L5 9.2zm8 9.2l6-2.7V9.2l-6 2.7v6.5z"/></svg>
                        <span class="bpcol-label"><strong>Collecting your order?</strong><span>Read our collection process</span></span>
                    </button>
                    </div>

                    <div id="shippingDetails" style="margin-top: 15px;">
                    <button
                    type="button"
                    id="delivery-btn"
                    class="cart-footer-action-btn required-btn-empty"
                    onclick="openDeliveryPopup()"
                    >
                    Delivery Contact Details *
                    </button>

                    <div id="deliveryPreview" style="display: none; margin-top: 10px; padding: 15px; background-color: #f8f8f8; border-radius: 8px; border: 1px solid #e0e0e0;">
                    <div id="previewDeliveryName" style="margin-bottom: 8px;"></div>
                    <div id="previewDeliveryPhone" style="margin-bottom: 8px;"></div>
                    <div id="previewDeliveryNotes"></div>
                    </div>
                    </div>
                </div>

                <div class="cart-footer-fields__col">
                    <label class="cart-footer-field-label">Name and address on product:</label>
                    <div class="product-address-toggle" id="productAddressToggle">
                        <button type="button" class="toggle-btn selected" data-value="bite" onclick="selectProductAddressChoice('bite')">Bite Promotions</button>
                        <button type="button" class="toggle-btn" data-value="own" onclick="selectProductAddressChoice('own')">Custom</button>
                    </div>

                    <div id="yourOwnAddressSection" style="display: none; margin-top: 15px;">
                    <button
                    type="button"
                    name="product_name"
                    id="product-name"
                    class="cart-footer-action-btn required-btn-empty"
