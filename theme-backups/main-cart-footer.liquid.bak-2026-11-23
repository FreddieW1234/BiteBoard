                    <div class="totals">
                        <h2 class="totals__total">{{ 'sections.cart.estimated_total' | t }}</h2>
                        <p class="totals__total-value">{{ cart.total_price | money }}</p>
                    </div>

                    <small class="tax-note caption-large rte">
                        {%- if cart.duties_included and cart.taxes_included -%}
                        {%- if shop.shipping_policy.body == blank -%}
                            {{ 'sections.cart.duties_and_taxes_included_shipping_at_checkout_without_policy' | t }}
                        {%- else -%}
                            {{
                            'sections.cart.duties_and_taxes_included_shipping_at_checkout_with_policy_html'
                            | t: link: shop.shipping_policy.url
                            }}
                        {%- endif -%}
                        {%- elsif cart.duties_included == false and cart.taxes_included -%}
                        {%- if shop.shipping_policy.body == blank -%}
                            {{ 'sections.cart.taxes_included_shipping_at_checkout_without_policy' | t }}
                        {%- else -%}
                            {{
                            'sections.cart.taxes_included_shipping_at_checkout_with_policy_html'
                            | t: link: shop.shipping_policy.url
                            }}
                        {%- endif -%}
                        {%- elsif cart.duties_included and cart.taxes_included == false -%}
                        {%- if shop.shipping_policy.body == blank -%}
                            {{ 'sections.cart.duties_included_taxes_at_checkout_shipping_at_checkout_without_policy' | t }}
                        {%- else -%}
                            {{
                            'sections.cart.duties_included_taxes_at_checkout_shipping_at_checkout_with_policy_html'
                            | t: link: shop.shipping_policy.url
                            }}
                        {%- endif -%}
                        {%- elsif cart.duties_included == false and cart.taxes_included == false -%}
                        {%- if shop.shipping_policy.body == blank -%}
                            {{ 'sections.cart.taxes_at_checkout_shipping_at_checkout_without_policy' | t }}
                        {%- else -%}
                            {{
                            'sections.cart.taxes_at_checkout_shipping_at_checkout_with_policy_html'
                            | t: link: shop.shipping_policy.url
                            }}
                        {%- endif -%}
                        {%- endif -%}
                    </small>
                    </div>
                {%- when 'buttons' -%}
                    <div class="cart__ctas" {{ block.shopify_attributes }}>
                    <button
                        type="submit"
                        id="checkout"
                        class="cart__checkout-button button"
                        name="checkout"
                        {% if cart == empty %}
                        disabled
                        {% endif %}
                        form="cart"
                    >
                        {{ 'sections.cart.checkout' | t }}
                    </button>
                    </div>

                    {%- if additional_checkout_buttons -%}
                    <div class="cart__dynamic-checkout-buttons additional-checkout-buttons">
                        {{ content_for_additional_checkout_buttons }}
                    </div>
                    {%- endif -%}
                {%- endcase -%}
            {% endfor %}

            <div id="cart-errors"></div>
            </div>
            </div>
        </div>
        </div>
    </div>

    {%- comment -%} Artwork templates — detect cart products that have custom.artworktemplates set {%- endcomment -%}
    {%- assign artwork_titles_string = '' -%}
    {%- for item in cart.items -%}
        {%- assign _artwork_templates = item.product.metafields.custom.artworktemplates -%}
        {%- if _artwork_templates != blank and _artwork_templates.value != blank -%}
        {%- unless artwork_titles_string contains item.product.title -%}
            {%- assign artwork_titles_string = artwork_titles_string | append: item.product.title | append: '~|~' -%}
        {%- endunless -%}
        {%- endif -%}
    {%- endfor -%}
    {%- assign artwork_titles = artwork_titles_string | split: '~|~' -%}

    <!-- Artwork Upload Reminder Popup -->
    <div id="artworkReminderPopup" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.5); z-index: 2147483647;">
        <div style="background: white; padding: 30px; border-radius: 15px; width: 560px; max-width: 92%; max-height: 90vh; overflow-y: auto; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);">
        <h3 style="margin: 0 0 10px 0; color: #333; font-size: 20px; text-align: center;">Your order needs artwork</h3>
        <p id="artworkReminderIntroWrap" style="margin: 0 0 20px 0; color: #555; font-size: 14px; line-height: 1.5; text-align: center;">
            <span id="artworkReminderIntro"></span>
        </p>

        <ul id="artworkReminderProductList" style="margin: 0 0 22px 0; padding: 14px 18px 14px 34px; background-color: #f4f6ff; border: 1px solid #dde3ff; border-radius: 10px; color: #333; font-size: 14px; line-height: 1.6;"></ul>

        <div style="background-color: #fff8e6; border: 1px solid #ffe1a3; border-radius: 10px; padding: 16px 18px; margin-bottom: 22px;">
            <div style="font-weight: 700; color: #333; margin-bottom: 10px; font-size: 14px;">After you have placed your order:</div>
            <ol style="margin: 0; padding-left: 20px; color: #555; font-size: 14px; line-height: 1.7;">
            <li>
                Come back to our site and click the account icon
                <span style="display: inline-flex; vertical-align: middle; align-items: center; justify-content: center; width: 24px; height: 24px; border: 1px solid #ccc; border-radius: 50%; margin: 0 2px;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#333" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                    <circle cx="12" cy="7" r="4"></circle>
                </svg>
                </span>
                at the top right of the page to reach your orders.
            </li>
            <li>Select the order you have just placed.</li>
            <li>Click the <strong>Upload Artwork</strong> button and send us your files.</li>
            </ol>
        </div>

        <div style="background-color: #f0f7f2; border: 1px solid #cfe6d8; border-radius: 10px; padding: 16px 18px; margin-bottom: 25px;">
            <div style="font-weight: 700; color: #333; margin-bottom: 6px; font-size: 14px;">Then look out for your proofs</div>
            <p style="margin: 0; color: #555; font-size: 14px; line-height: 1.6;">
            Once we have prepared your proofs you will need to return to that same order page to <strong>review and approve</strong> them. We cannot begin production until your artwork is uploaded and your proofs are approved.
            </p>
        </div>

        <div style="display: flex; gap: 15px; justify-content: center; flex-wrap: wrap;">
            <button
            type="button"
            onclick="proceedToCheckoutFromArtworkPopup()"
            style="background: #5977ED; color: white; border: none; padding: 12px 24px; border-radius: 8px; font-weight: 600; cursor: pointer; font-size: 14px; transition: background-color 0.3s ease;"
            onmouseover="this.style.background='#5955BB'"
            onmouseout="this.style.background='#5977ED'"
            >
            I understand — continue to checkout
            </button>
            <button
            type="button"
            onclick="closeArtworkReminderPopup()"
            style="background: #888; color: white; border: none; padding: 12px 24px; border-radius: 8px; font-weight: 600; cursor: pointer; font-size: 14px; transition: background-color 0.3s ease;"
            onmouseover="this.style.background='#666'"
            onmouseout="this.style.background='#888'"
            >
            Back to basket
            </button>
        </div>
        </div>
    </div>

    <!-- Collection Procedure Popup -->
    <dialog id="collectionPopup" class="bpcol-dialog" aria-labelledby="collectionPopupTitle">
        <div class="bpcol-inner">
        <button type="button" class="bpcol-x" aria-label="Close" onclick="closeCollectionPopup()">&times;</button>
        <h2 id="collectionPopupTitle">Collecting your order</h2>
        <p>To collect your order you will need to follow the step-by-step process below to receive your order on time.</p>
        <h3>Our collection procedure</h3>
        <ul>
            <li>We will provide a collection date once your proof is approved.</li>
            <li>We will provide a collection reference for your driver to confirm on arrival.</li>
            <li>You will need to confirm which courier company will be collecting on your behalf. This is required 24 hours before the collection date.</li>
            <li>Once you receive your collection reference, you will need to pass this on to your driver.</li>
            <li>We will require delivery labelling at least 24 hours before the collection date. This will need to be sent to us by email.</li>
            <li>When your driver arrives on the date of collection, they will need to provide the collection reference number.</li>
            <li>We will hand over your order when the driver provides the correct reference number.</li>
            <li>Our collection department is closed from 1pm to 1.30pm and closes at 4pm. We may not be able to hand over your order if your driver arrives late, so please inform your courier company of this.</li>
            <li>Please contact us for shipping box dimensions and weight.</li>
        </ul>
        <h3>Our collection address</h3>
        <address>The Chocolate Factory<br>3 Kenfig Industrial Estate<br>Port Talbot<br>South Wales<br>SA13 2PE</address>
        <p>Please call <a href="tel:01792293689">01792 293689</a> or email <a href="mailto:sales@bitepromotions.co.uk">sales@bitepromotions.co.uk</a> if you require further information.</p>
        <p class="bpcol-next"><strong>At checkout, choose <em>Pick up</em> as your delivery method.</strong></p>
        <div class="bpcol-actions">
            <button type="button" class="bpcol-close-btn" onclick="closeCollectionPopup()">Close</button>
            <button type="button" class="bpcol-go" onclick="proceedToCheckoutFromCollectionPopup()">Continue to checkout</button>
        </div>
        </div>
    </dialog>


    <script>
        /* ---------- Collection procedure popup ---------- */
        function openCollectionPopup() {
        const popup = document.getElementById('collectionPopup');
        if (!popup) return;
        if (popup.parentNode !== document.body) document.body.appendChild(popup);
        if (typeof popup.showModal === 'function') {
            if (!popup.open) popup.showModal();
        } else {
            popup.setAttribute('open', '');
        }
        }

        function closeCollectionPopup() {
        const popup = document.getElementById('collectionPopup');
        if (!popup) return;
        if (typeof popup.close === 'function') popup.close(); else popup.removeAttribute('open');
        }

        // Goes through the normal checkout checks (PO number, delivery details,
        // artwork reminder) exactly as if Check out had been clicked.
        function proceedToCheckoutFromCollectionPopup() {
        closeCollectionPopup();
        const cartForm = document.getElementById('cart');
        const checkoutButton = document.getElementById('checkout');
        if (!cartForm) return;
        if (typeof cartForm.requestSubmit === 'function' && checkoutButton) {
            cartForm.requestSubmit(checkoutButton);
        } else if (checkoutButton) {
            checkoutButton.click();
        }
        }

        document.addEventListener('DOMContentLoaded', function () {
        const popup = document.getElementById('collectionPopup');
        if (popup) {
            // Close when clicking the dimmed area outside the box
            popup.addEventListener('click', function (e) { if (e.target === popup) closeCollectionPopup(); });
        }
        });

        /* ---------- Delivery method (Shipping / Pickup) ---------- */
        window.deliveryMethod = 'shipping';

        function selectDeliveryMethod(method) {
        window.deliveryMethod = method;

        document.querySelectorAll('.method-btn').forEach(function (btn) {
            const on = btn.dataset.method === method;
            btn.classList.toggle('selected', on);
            btn.setAttribute('aria-pressed', on ? 'true' : 'false');
        });

        const shipping = document.getElementById('shippingDetails');
        const pickup = document.getElementById('pickupDetails');
        if (shipping) shipping.style.display = method === 'shipping' ? 'block' : 'none';
        if (pickup) pickup.style.display = method === 'pickup' ? 'block' : 'none';

        clearValidationMessage();
        updateRequiredFieldStates();
        }

        window.productNameChoice = 'bite';
        window.savedName = 'Bite Promotions';
        window.savedDeliveryName = '';
        window.savedDeliveryPhone = '';
        window.savedDeliveryNotes = '';

        /* ---------- Artwork upload reminder ---------- */
        window.biteArtworkProducts = {{ artwork_titles | json }};
        window.biteArtworkAcknowledged = false;
        let artworkReminderOriginalContainer = null;

        function openArtworkReminderPopup() {
        const popup = document.getElementById('artworkReminderPopup');
        if (!popup) return;

        const list = document.getElementById('artworkReminderProductList');
        const intro = document.getElementById('artworkReminderIntro');
        const products = window.biteArtworkProducts || [];

        if (intro) {
            intro.textContent = products.length === 1
            ? 'The following item in your basket needs artwork from you before we can start production:'
            : 'The following items in your basket need artwork from you before we can start production:';
        }

        if (list) {
            list.innerHTML = products.map(function (name) {
            const li = document.createElement('li');
            li.textContent = name;
            return li.outerHTML;
            }).join('');
        }

        artworkReminderOriginalContainer = popup.parentNode;
        if (popup.parentNode !== document.body) {
            document.body.appendChild(popup);
        }

        popup.style.display = 'flex';
        popup.style.alignItems = 'center';
        popup.style.justifyContent = 'center';
        document.body.style.overflow = 'hidden';
        }

        function closeArtworkReminderPopup() {
        const popup = document.getElementById('artworkReminderPopup');
        if (!popup) return;

        popup.style.display = 'none';
        document.body.style.overflow = 'auto';

        if (artworkReminderOriginalContainer && popup.parentNode === document.body) {
            artworkReminderOriginalContainer.appendChild(popup);
        }
        }

        function proceedToCheckoutFromArtworkPopup() {
        window.biteArtworkAcknowledged = true;
        closeArtworkReminderPopup();

        const cartForm = document.getElementById('cart');
        const checkoutButton = document.getElementById('checkout');
        if (!cartForm) return;

        if (typeof cartForm.requestSubmit === 'function' && checkoutButton) {
            cartForm.requestSubmit(checkoutButton);
        } else if (checkoutButton) {
            checkoutButton.click();
        }
        }

        function clearValidationMessage() {
        const existingMessage = document.querySelector('.validation-message');
        if (existingMessage) existingMessage.remove();
        }

        function pulseValidationField(el) {
        if (!el) return;
        el.classList.remove('validation-pulse-once');
        void el.offsetWidth;
        el.classList.add('validation-pulse-once');
        function onEnd() {
            el.classList.remove('validation-pulse-once');
            el.removeEventListener('animationend', onEnd);
        }
        el.addEventListener('animationend', onEnd);
        }
        window.pulseValidationField = pulseValidationField;

        function pulseMissingValidationFields(validation) {
        if (!validation.hasPONumber) {
            pulseValidationField(document.getElementById('po-number'));
        }
        if (!validation.hasDeliveryName || !validation.hasDeliveryPhone) {
            pulseValidationField(document.getElementById('delivery-btn'));
        }
        if (!validation.hasProductChoice) {
            pulseValidationField(document.getElementById('productAddressToggle'));
        } else if (window.productNameChoice === 'own' && (!validation.hasName || !validation.hasAddress || !validation.hasPostcode)) {
            pulseValidationField(document.getElementById('product-name'));
        }
        if (!validation.hasDeliveryDate && typeof window.pulseMissingDeliveryDateFields === 'function') {
            window.pulseMissingDeliveryDateFields();
        }
        }

        function updateRequiredFieldStates() {
        const poField = document.getElementById('po-number');
        if (poField) {
            if (poField.value.trim()) {
            poField.classList.remove('required-empty');
            poField.classList.add('required-filled');
            } else {
            poField.classList.remove('required-filled');
            poField.classList.add('required-empty');
            }
        }

        const toggle = document.getElementById('productAddressToggle');
        if (toggle) {
            if (window.productNameChoice) {
            toggle.classList.remove('required-empty');
            } else {
            toggle.classList.add('required-empty');
            }
        }

        const productBtn = document.getElementById('product-name');
        if (productBtn && window.productNameChoice === 'own') {
            const ownComplete = window.savedName && window.savedName.trim() !== '' &&
                            window.savedAddress && window.savedAddress.trim() !== '' &&
                            window.savedPostcode && window.savedPostcode.trim() !== '';
            productBtn.classList.remove('required-btn-empty', 'required-btn-filled');
            productBtn.classList.add(ownComplete ? 'required-btn-filled' : 'required-btn-empty');
        }

        const deliveryBtn = document.getElementById('delivery-btn');
        if (deliveryBtn) {
            const deliveryComplete = window.savedDeliveryName && window.savedDeliveryName.trim() !== '' &&
                                    window.savedDeliveryPhone && window.savedDeliveryPhone.trim() !== '';
            deliveryBtn.classList.remove('required-btn-empty', 'required-btn-filled');
            deliveryBtn.classList.add(deliveryComplete ? 'required-btn-filled' : 'required-btn-empty');
        }
        }

        function selectProductAddressChoice(choice) {
        window.productNameChoice = choice;

        document.querySelectorAll('.toggle-btn').forEach(function(btn) {
            btn.classList.toggle('selected', btn.dataset.value === choice);
        });

        const yourOwnSection = document.getElementById('yourOwnAddressSection');
        if (yourOwnSection) {
            yourOwnSection.style.display = choice === 'own' ? 'block' : 'none';
        }

        if (choice === 'bite') {
            window.savedName = 'Bite Promotions';
            window.savedAddress = '';
            window.savedPostcode = '';
            const previewBox = document.getElementById('nameAddressPreview');
            if (previewBox) previewBox.style.display = 'none';
        } else {
            window.savedName = '';
            window.savedAddress = '';
            window.savedPostcode = '';
        }

        clearValidationMessage();
        updateRequiredFieldStates();
        }

        function openNameAddressPopup() {
        const popup = document.getElementById('nameAddressPopup');
        
        if (popup.parentNode !== document.body) {
            document.body.appendChild(popup);
        }
        
        popup.style.display = 'flex';
        popup.style.alignItems = 'center';
        popup.style.justifyContent = 'center';
        document.body.style.overflow = 'hidden';
        }
        
        function closeNameAddressPopup() {
        const popup = document.getElementById('nameAddressPopup');
        popup.style.display = 'none';
        
        const originalContainer = document.querySelector('.cart__footer');
        if (originalContainer && popup.parentNode === document.body) {
            originalContainer.appendChild(popup);
        }
        
        document.body.style.overflow = 'auto';
        }

        function openDeliveryPopup() {
        const popup = document.getElementById('deliveryPopup');

        if (popup.parentNode !== document.body) {
            document.body.appendChild(popup);
        }

        document.getElementById('popup-delivery-name').value = window.savedDeliveryName || '';
        document.getElementById('popup-delivery-phone').value = window.savedDeliveryPhone || '';
        document.getElementById('popup-delivery-notes').value = window.savedDeliveryNotes || '';

        popup.style.display = 'flex';
        popup.style.alignItems = 'center';
        popup.style.justifyContent = 'center';
        document.body.style.overflow = 'hidden';
        }

        function closeDeliveryPopup() {
        const popup = document.getElementById('deliveryPopup');
        popup.style.display = 'none';

        const originalContainer = document.querySelector('.cart__footer');
        if (originalContainer && popup.parentNode === document.body) {
            originalContainer.appendChild(popup);
        }

        document.body.style.overflow = 'auto';
        }

        function saveDelivery() {
        const name = document.getElementById('popup-delivery-name').value.trim();
        const phone = document.getElementById('popup-delivery-phone').value.trim();
        const notes = document.getElementById('popup-delivery-notes').value.trim();

        window.savedDeliveryName = name;
        window.savedDeliveryPhone = phone;
        window.savedDeliveryNotes = notes;

        const previewBox = document.getElementById('deliveryPreview');
        const previewName = document.getElementById('previewDeliveryName');
        const previewPhone = document.getElementById('previewDeliveryPhone');
        const previewNotes = document.getElementById('previewDeliveryNotes');
        const button = document.getElementById('delivery-btn');

        if (previewBox && previewName && previewPhone && previewNotes) {
            if (name || phone || notes) {
            previewName.innerHTML = name ? `<strong>Name:</strong> ${name}` : '';
            previewPhone.innerHTML = phone ? `<strong>Phone:</strong> ${phone}` : '';
            previewNotes.innerHTML = notes ? `<strong>Delivery Notes:</strong> ${notes}` : '';
            previewBox.style.display = 'block';
            } else {
            previewBox.style.display = 'none';
            }
        }

        if (button) {
            button.textContent = (name && phone) ? 'Edit Delivery Details' : 'Delivery Details *';
        }

        closeDeliveryPopup();
        clearValidationMessage();
        updateRequiredFieldStates();
        }
        
        function saveNameAddress() {
        const name = document.getElementById('popup-name').value;
        const address = document.getElementById('popup-address').value;
        const postcode = document.getElementById('popup-postcode').value;
        
        const previewBox = document.getElementById('nameAddressPreview');
        const previewName = document.getElementById('previewName');
        const previewAddress = document.getElementById('previewAddress');
        
        if (previewBox && previewName && previewAddress) {
            const addressLines = address.split('\n').filter(line => line.trim() !== '');
            let addressHTML = addressLines.map(line => `<div style="margin-bottom: 2px;">${line}</div>`).join('');
            
            if (postcode.trim()) {
            addressHTML += `<div style="margin-bottom: 2px;">${postcode}</div>`;
            }
            
            previewName.innerHTML = `<strong>Company name:</strong> ${name}`;
            previewAddress.innerHTML = `<strong>Company address:</strong><br>${addressHTML}`;
            previewBox.style.display = 'block';
        }
        
        const button = document.getElementById('product-name');
        if (button) {
            button.textContent = (name.trim() && address.trim() && postcode.trim()) ? 'Edit' : 'Company name and address to show on product *';
        }
        
        window.savedName = name;
        window.savedAddress = address;
        window.savedPostcode = postcode;
        
        closeNameAddressPopup();
        clearValidationMessage();
        updateRequiredFieldStates();
        }
        
        document.getElementById('nameAddressPopup').addEventListener('click', function(e) {
        if (e.target === this) {
            closeNameAddressPopup();
        }
        });

        document.getElementById('deliveryPopup').addEventListener('click', function(e) {
        if (e.target === this) {
            closeDeliveryPopup();
        }
        });
        
        function checkCheckoutValidation() {
        const missingDeliveryProducts = typeof window.getMissingDeliveryDateProducts === 'function'
            ? window.getMissingDeliveryDateProducts()
            : [];
        const hasDeliveryDate = missingDeliveryProducts.length === 0;

        let hasName = false;
        let hasAddress = false;
        let hasPostcode = false;

        if (window.productNameChoice === 'bite') {
            hasName = true;
            hasAddress = true;
            hasPostcode = true;
        } else if (window.productNameChoice === 'own') {
            hasName = window.savedName && window.savedName.trim() !== '';
            hasAddress = window.savedAddress && window.savedAddress.trim() !== '';
            hasPostcode = window.savedPostcode && window.savedPostcode.trim() !== '';
        }
        
        const hasPONumber = document.getElementById('po-number').value.trim() !== '';
        const isPickup = window.deliveryMethod === 'pickup';
        const hasDeliveryName = isPickup || (window.savedDeliveryName && window.savedDeliveryName.trim() !== '');
        const hasDeliveryPhone = isPickup || (window.savedDeliveryPhone && window.savedDeliveryPhone.trim() !== '');
        const hasProductChoice = window.productNameChoice !== null;
        
        clearValidationMessage();
        
        return { hasDeliveryDate, missingDeliveryProducts, hasName, hasAddress, hasPostcode, hasPONumber, hasDeliveryName, hasDeliveryPhone, hasProductChoice };
        }
        
        // Function to show validation errors
        function showValidationErrors() {
        const validation = checkCheckoutValidation();
        
        // Remove any existing validation message
        const existingMessage = document.querySelector('.validation-message');
        if (existingMessage) {
            existingMessage.remove();
        }
        
        if (validation.hasDeliveryDate && validation.hasProductChoice && validation.hasName && validation.hasAddress && validation.hasPostcode && validation.hasPONumber && validation.hasDeliveryName && validation.hasDeliveryPhone) {
            return true;
        } else {
            const missingItems = [];
            if (!validation.hasDeliveryDate) {
            missingItems.push('Request delivery date for: ' + validation.missingDeliveryProducts.join(', '));
            }

            if (!validation.hasProductChoice) {
            missingItems.push('Name and address on product (Bite Promotions or Custom)');
            } else if (window.productNameChoice === 'own') {
            if (!validation.hasName && !validation.hasAddress) {
                missingItems.push('Company name and address to show on product');
            } else if (!validation.hasName) {
                missingItems.push('Company name to show on product');
            } else if (!validation.hasAddress) {
                missingItems.push('Company address to show on product');
            } else if (!validation.hasPostcode) {
                missingItems.push('Company post code to show on product');
            }
            }
            
            if (!validation.hasPONumber) missingItems.push('PO Number');
            
            if (!validation.hasDeliveryName && !validation.hasDeliveryPhone) {
            missingItems.push('Delivery name and phone number');
            } else if (!validation.hasDeliveryName) {
            missingItems.push('Delivery name');
            } else if (!validation.hasDeliveryPhone) {
            missingItems.push('Delivery phone number');
            }
            
            const checkoutButton = document.getElementById('checkout');
            const buttonContainer = checkoutButton.parentElement;
            
            // Create validation message after the button container, not inside it
            const validationDiv = document.createElement('div');
            validationDiv.className = 'validation-message';
            validationDiv.style.cssText = 'margin-top: 15px; padding: 15px; background-color: #fff3cd; border: 1px solid #ffeaa7; border-radius: 8px; color: #856404; width: 100%; max-width: 400px; margin-left: auto; margin-right: 0;';
            
            validationDiv.innerHTML = `
            <div style="margin-bottom: 10px; font-weight: 600;">Please complete the following before checkout:</div>
            <ul style="margin: 0; padding-left: 20px;">
                ${missingItems.map(item => `<li>${item}</li>`).join('')}
            </ul>
            `;
            
            // Insert the validation message after the button container, not inside it
            buttonContainer.parentElement.insertBefore(validationDiv, buttonContainer.nextSibling);
            pulseMissingValidationFields(validation);
            return false;
        }
        }
        
        // Initialize footer form behaviour when page loads
        document.addEventListener('DOMContentLoaded', function() {
        const poField = document.getElementById('po-number');
        if (poField) {
            poField.addEventListener('input', function() {
            clearValidationMessage();
            updateRequiredFieldStates();
            });
        }

        updateRequiredFieldStates();
        
        const cartForm = document.getElementById('cart');
        if (cartForm) {
            cartForm.addEventListener('submit', function(e) {
            if (!showValidationErrors()) {
                e.preventDefault(); // Prevent form submission if validation fails
                return;
            }

            // Artwork templates present? Show the upload/proofs reminder before leaving the basket
            if (window.biteArtworkProducts && window.biteArtworkProducts.length > 0 && !window.biteArtworkAcknowledged) {
                e.preventDefault();
                openArtworkReminderPopup();
                return;
            }

            // Validation passed and reminder acknowledged - compile order data into hidden field
            compileOrderDataIntoHiddenField();
            });
        }
        
        // Function to compile order data into hidden field for Shopify order notes
        function compileOrderDataIntoHiddenField() {
            const hiddenNotesField = document.getElementById('shopify-order-notes');
            if (!hiddenNotesField) return;
            
            // Get all the form data
            const poNumber = document.getElementById('po-number').value.trim();
            const deliveryName = window.savedDeliveryName || '';
            const deliveryPhone = window.savedDeliveryPhone || '';
            const deliveryNotes = window.savedDeliveryNotes || '';
            const userNotes = document.getElementById('notes').value.trim();

            let deliveryDatesSection = '';
            document.querySelectorAll('.cart-item[data-line-key]').forEach(function(row) {
            const lineKey = row.dataset.lineKey;
            const date = window.lineItemDeliveryDates && window.lineItemDeliveryDates[lineKey];
            if (date) {
                const title = row.dataset.productTitle || 'Product';
                const sku = row.dataset.variantSku || 'N/A';
                const formattedDate = typeof window.formatDeliveryDate === 'function'
                ? window.formatDeliveryDate(date)
                : date.toLocaleDateString('en-GB');
                deliveryDatesSection += `${title} (${sku}): ${formattedDate}\n`;
            }
            });
            
            // Get name and address data
            let productName = '';
            let productAddress = '';
            if (window.productNameChoice === 'bite') {
            productName = 'Bite Promotions';
            } else if (window.savedName && window.savedAddress) {
            productName = window.savedName.trim();
            productAddress = window.savedAddress.trim();
            if (window.savedPostcode) {
                productAddress += '\n' + window.savedPostcode.trim();
            }
            }
            
            // Compile all data into a structured format
            let compiledNotes = '';
            
            if (poNumber) {
            compiledNotes += `PO NUMBER: ${poNumber}\n\n`;
            }
            
            if (productName || productAddress) {
            compiledNotes += `NAME AND ADDRESS ON PRODUCT:\n`;
            if (productName) compiledNotes += `Name: ${productName}\n`;
            if (productAddress) compiledNotes += `Address:\n${productAddress}\n`;
            compiledNotes += '\n';
            }
            
            if (deliveryDatesSection) {
            compiledNotes += `REQUEST DELIVERY DATES:\n${deliveryDatesSection}\n`;
            }
            
            compiledNotes += `DELIVERY METHOD: ${window.deliveryMethod === 'pickup' ? 'Pickup (customer collecting)' : 'Shipping'}\n\n`;

            if (window.deliveryMethod !== 'pickup' && (deliveryName || deliveryPhone || deliveryNotes)) {
            compiledNotes += `DELIVERY CONTACT:\n`;
            if (deliveryName) compiledNotes += `Name: ${deliveryName}\n`;
            if (deliveryPhone) compiledNotes += `Phone: ${deliveryPhone}\n`;
            if (deliveryNotes) compiledNotes += `Delivery Notes: ${deliveryNotes}\n`;
            compiledNotes += '\n';
            }
            
            if (userNotes) {
            compiledNotes += `ADDITIONAL NOTES:\n${userNotes}`;
            }
            
            // Update the hidden field with compiled data
            hiddenNotesField.value = compiledNotes.trim();
        }
        
        // Initialize checkout button state (no validation needed initially)
        });
        
        // Auto-resize notes textarea as user types
        document.addEventListener('DOMContentLoaded', function() {
        const notesTextarea = document.getElementById('notes');
        if (notesTextarea) {
            notesTextarea.addEventListener('input', function() {
            this.style.height = 'auto';
            this.style.height = Math.min(this.scrollHeight, 120) + 'px'; // Max height of 120px
            });
        }
        });
    </script>
    {%- endif -%}

